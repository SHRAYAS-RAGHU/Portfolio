# ─── Dependencies ─────────────────────────────────────────
node_modules/
# NOTE: package-lock.json is intentionally NOT ignored.
# The GitHub Actions workflow uses `npm ci`, which requires it.

# ─── Angular build output & caches ────────────────────────
/dist/
/out-tsc/
/tmp/
/.angular/
/.sass-cache/
/coverage/

# ─── Logs ─────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ─── Environment & secrets (never commit) ─────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Editors & IDEs ───────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
*.sublime-workspace

# ─── OS files ─────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Misc ─────────────────────────────────────────────────
.history/
*.tgz
.eslintcache
.cache/
